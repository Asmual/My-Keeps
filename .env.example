# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/my_keeps?retryWrites=true&w=majority

# Better Auth Secret (generate a random 32+ char string)
BETTER_AUTH_SECRET=your_32_character_random_secret_here

# Application Base URL (e.g. https://your-project.vercel.app or http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Optional: Next Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
